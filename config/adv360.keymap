#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
  behaviors {
    #include "macros.dtsi"
    #include "version.dtsi"

    hm: homerow_mods {
        compatible = "zmk,behavior-hold-tap";
        label = "HOMEROW_MODS";
        #binding-cells = <2>;
        tapping-term-ms = <200>;
        // quick_tap_ms = <175>;  // deprecated
        flavor = "tap-preferred";
        bindings = <&kp>, <&kp>;
    };

    // === Top row left (positions 1–6): $ & { ( [ =  with Shift: ~ 7 5 3 1 0 ===
    sm_dollar_tilde: sm_dollar_tilde {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_$~";
      bindings = <&kp DOLLAR>, <&kp TILDE>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    sm_amp_7: sm_amp_7 {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_&7";
      bindings = <&kp AMPERSAND>, <&kp N7>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    sm_lbrace_5: sm_lbrace_5 {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_{5";
      bindings = <&kp LEFT_BRACE>, <&kp N5>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    sm_lparen_3: sm_lparen_3 {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_(3";
      bindings = <&kp LEFT_PARENTHESIS>, <&kp N3>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    sm_lbracket_1: sm_lbracket_1 {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_[1";
      bindings = <&kp LEFT_BRACKET>, <&kp N1>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    sm_equal_0: sm_equal_0 {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_=0";
      bindings = <&kp EQUAL>, <&kp N0>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    // === Top row right (positions 7–12): + ] ) } % \  with Shift: 9 2 4 6 8 | ===
    sm_plus_9: sm_plus_9 {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_+9";
      bindings = <&kp PLUS>, <&kp N9>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    sm_rbracket_2: sm_rbracket_2 {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_]2";
      bindings = <&kp RIGHT_BRACKET>, <&kp N2>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    sm_rparen_4: sm_rparen_4 {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_)4";
      bindings = <&kp RIGHT_PARENTHESIS>, <&kp N4>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    sm_rbrace_6: sm_rbrace_6 {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_}6";
      bindings = <&kp RIGHT_BRACE>, <&kp N6>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    sm_percent_8: sm_percent_8 {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_%8";
      bindings = <&kp PERCENT>, <&kp N8>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
     
    // Row 4 to swap comma and dot
    // .  -> <  (when Shift is held)
    sm_dot_lt: sm_dot_lt {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_.<";
      bindings = <&kp DOT>, <&kp LESS_THAN>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    // ,  -> >  (when Shift is held)
    sm_comma_gt: sm_comma_gt {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_,>";
      bindings = <&kp COMMA>, <&kp GREATER_THAN>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    // Bottom row, left half
    //  *  -> `    (replacing ` -> ~)
    sm_ast_g: sm_asterisk_grave {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_*`";
      bindings = <&kp ASTERISK>, <&kp GRAVE>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
 
    // Bottom row, right half
    //  #  -> @    (replacing [ -> {)
    //  !  -> ^    (replacing ] -> })
    sm_hash_at: sm_hash_at {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_#@";
      bindings = <&kp HASH>, <&kp AT>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    sm_bang_caret: sm_bang_caret {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      // label = "SM_!^";
      bindings = <&kp EXCLAMATION>, <&kp CARET>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    // Thumb keys: Shift swaps Backspace/Space and Delete/Enter
    sm_bspc_space: sm_bspc_space {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp BACKSPACE>, <&kp SPACE>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    sm_del_enter: sm_del_enter {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DELETE>, <&kp ENTER>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    sm_enter_del: sm_enter_del {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp ENTER>, <&kp DELETE>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    sm_space_bspc: sm_space_bspc {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp SPACE>, <&kp BACKSPACE>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        // Row 1
        // $~            &7        {5           (3           [1             =0          kp                                                                      Mod   +9         ]2             )4           }6           %8             \|
        &sm_dollar_tilde &sm_amp_7 &sm_lbrace_5 &sm_lparen_3 &sm_lbracket_1 &sm_equal_0 &tog 1                                                                  &mo 3 &sm_plus_9 &sm_rbracket_2 &sm_rparen_4 &sm_rbrace_6 &sm_percent_8  &kp BSLH
        
        // Row 2        
        // Tab           qQ        wW           fF           pP             bB          (1)                                                                     (3)   jJ         lL             uU           yY           ;:             /?  
        &kp TAB          &kp Q     &kp W        &kp F        &kp P          &kp B       &none                                                                   &none &kp J      &kp L          &kp U        &kp Y        &kp SEMI       &kp SLASH
        
        // Row 3
        // Esc           aA        rR           sS           tT             gG          (2)                    Ctrl    Command  Alt        Ctrl                 (4)   mM         nN             eE           iI           oO             -_
        &kp ESC          &kp A     &kp R        &kp S        &kp T          &kp G       &none             &kp LCTRL   &kp LGUI  &kp LALT   &kp RCTRL            &none &kp M      &kp N          &kp E        &kp I        &kp O          &kp MINUS
                                                                                                                                                               
        // Row 4                                                                                                                                              
        // Shift         xX        cC           dD           vV             zZ                                            Home  Page Up                                          kK             hH           .<           ,>             '"
        &kp LSHFT        &kp X     &kp C        &kp D        &kp V          &kp Z                                     &kp HOME  &kp PG_UP                                        &kp K          &kp H        &sm_dot_lt   &sm_comma_gt   &kp SQT        &kp RSHFT
                                                                                                                                                             
        // Row                                                                                                                            
        // fn            *`        Caps         Left Arrow   Right Arrow                 Backsp/Spc     Delete/Ent         End  Page Dwn   Enter/Del      Space/Bspc                            Up Arrow     Down Arrow   #@             !^             fn
        &mo 2            &sm_ast_g &kp CAPS     &kp LEFT     &kp RIGHT               &sm_bspc_space  &sm_del_enter     &kp END  &kp PG_DN  &sm_enter_del  &sm_space_bspc                        &kp UP       &kp DOWN     &sm_hash_at    &sm_bang_caret &mo 2
      >;
    };

    keypad {
      display-name = "Kp";
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                            &mo 3 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                             &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LGUI  &kp LALT  &kp RCTRL           &none &kp H  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME  &kp PG_UP                           &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &sm_bspc_space &sm_del_enter &kp END &kp PG_DN &sm_enter_del &kp KP_N0    &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 2
      >;
    };
    fn {
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6  &tog 1                                          &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };

    mod {
      display-name = "Mod";
      bindings = <
        &none              &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                               &trans               &none     &none        &none        &none &none &none
        &none              &none        &none        &none        &none        &none        &bootloader                                                         &bootloader          &none     &none        &none        &none &none &none
        &studio_unlock     &none        &none        &none        &none        &none        &none          &none &none  &bt BT_CLR  &none                       &stp STP_BAT         &none     &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                          &none  &none                                                        &none     &none        &none        &none &none &none
        &none &none        &none        &none        &none                                           &none &none &none  &none       &bl BL_TOG &rgb_ug RGB_TOG                                 &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
